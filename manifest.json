{
  "manifest_version": 3,
  "name": "day1tabs",
  "version": "3.0.0",
  "description": "Start every day with a clean browser. Auto-close tabs at midnight, wake up to what matters.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "pages/panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
